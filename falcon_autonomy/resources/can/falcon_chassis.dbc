BA_ "VFrameFormat" BO_ 193 14;
VAL_ 163 EPS_STATUS 0 "ok" 1 "safe_hold" 2 "fault" ;
VAL_ 164 BRAKE_STATUS 0 "released" 1 "applied" 2 "safe_hold" ;
VAL_ 165 MODE 0 "idle" 1 "active" 2 "safe_hold" 3 "aborted" ;
VAL_ 165 SURFACE 0 "dry_asphalt" 1 "wet_asphalt" 2 "waterlogged" 3 "gravel" 4 "snow" 5 "ice" ;
VAL_ 176 STEER_MODE 0 "off" 1 "angle" 2 "torque" ;
VAL_ 192 MODE 0 "idle" 1 "active" 2 "safe_hold" 3 "aborted" ;
VAL_ 192 SURFACE 0 "dry_asphalt" 1 "wet_asphalt" 2 "waterlogged" 3 "gravel" 4 "snow" 5 "ice" ;
VAL_ 193 STEER_MODE 0 "off" 1 "angle" 2 "torque" ;
