CM_ "Falcon Autonomy chassis emulation <-> device (docs/hardware.md). Generated from falcon_autonomy/core/canmsgs.py: do not edit.";
CM_ BO_ 160 "Wheel tick counters (ABS tone wheel edges) of the four wheels";
CM_ SG_ 160 TICKS_FL "FL wheel: tone-wheel edges since start, wraps at 4096";
CM_ SG_ 160 TICKS_FR "FR wheel: tone-wheel edges since start, wraps at 4096";
CM_ SG_ 160 TICKS_RL "RL wheel: tone-wheel edges since start, wraps at 4096";
CM_ SG_ 160 TICKS_RR "RR wheel: tone-wheel edges since start, wraps at 4096";
CM_ SG_ 160 QUALIFIER "bit per wheel FL FR RL RR: 1 = valid";
CM_ SG_ 160 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 160 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 161 "Wheel speeds from the wheels' rotation";
CM_ SG_ 161 SPEED_FL "FL wheel speed (its rotation × the rolling radius: slip shows)";
CM_ SG_ 161 SPEED_FR "FR wheel speed (its rotation × the rolling radius: slip shows)";
CM_ SG_ 161 SPEED_RL "RL wheel speed (its rotation × the rolling radius: slip shows)";
CM_ SG_ 161 SPEED_RR "RR wheel speed (its rotation × the rolling radius: slip shows)";
CM_ SG_ 161 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 161 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 162 "Yaw rate and accelerations (the vehicle's, ISO 8855)";
CM_ SG_ 162 YAW_RATE "yaw rate, left positive";
CM_ SG_ 162 LAT_ACCEL "lateral acceleration, left positive";
CM_ SG_ 162 LONG_ACCEL "longitudinal acceleration";
CM_ SG_ 162 STATUS "0 = valid";
CM_ SG_ 162 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 162 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 163 "The steering (EPS) as it is";
CM_ SG_ 163 STEER_ANGLE "steering wheel angle, left positive";
CM_ SG_ 163 STEER_RATE "steering wheel angle rate";
CM_ SG_ 163 EPS_TORQUE "torque the EPS applies";
CM_ SG_ 163 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 163 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 164 "The brake as it is, and the vehicle speed";
CM_ SG_ 164 BRAKE_PRESSURE "brake line pressure";
CM_ SG_ 164 BRAKE_REQ_ECHO "the pressure being requested (after the watchdog)";
CM_ SG_ 164 VEHICLE_SPEED "vehicle speed (over ground)";
CM_ SG_ 164 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 164 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 165 "The emulation's state";
CM_ SG_ 165 MU_EFF "the tyre–road friction coefficient in effect";
CM_ SG_ 165 WATCHDOG_TRIPS "commands that went stale (> 100 ms) since start";
CM_ SG_ 165 CMD_REJECTED "command frames rejected (CRC, counter, range)";
CM_ SG_ 165 HYDROPLANING "1 = the speed is past the hydroplaning onset";
CM_ SG_ 165 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 165 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 176 "Steering command";
CM_ SG_ 176 STEER_REQ "steering wheel angle request (angle mode), left positive";
CM_ SG_ 176 STEER_TORQUE_REQ "EPS torque request (torque mode)";
CM_ SG_ 176 ENABLE "1 = the device asks to be in control";
CM_ SG_ 176 STEP "the simulation step the command answers (low 12 bits)";
CM_ SG_ 176 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 176 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 177 "Longitudinal command (brake, throttle)";
CM_ SG_ 177 BRAKE_REQ "brake pressure request";
CM_ SG_ 177 THROTTLE_REQ "accelerator pedal";
CM_ SG_ 177 ENABLE "1 = the device asks to be in control";
CM_ SG_ 177 STEP "the simulation step the command answers (low 16 bits)";
CM_ SG_ 177 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 177 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 192 "All feedback in one CAN FD frame (bit-rate switched)";
CM_ SG_ 192 TICKS_FL "wraps at 65536";
CM_ SG_ 192 TICKS_FR "wraps at 65536";
CM_ SG_ 192 TICKS_RL "wraps at 65536";
CM_ SG_ 192 TICKS_RR "wraps at 65536";
CM_ SG_ 192 SIM_TIME "simulation time of the feedback, modulo 2^32 ms";
CM_ SG_ 192 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 192 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
CM_ BO_ 193 "Steering and longitudinal command in one CAN FD frame";
CM_ SG_ 193 STEP "the simulation step the command answers";
CM_ SG_ 193 COUNTER "alive counter, +1 per frame, modulo 16";
CM_ SG_ 193 CRC "CRC-8 SAE J1850 over the identifier (2 bytes, little-endian) and the bytes before this one";
BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;
