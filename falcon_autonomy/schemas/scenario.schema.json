{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/falcon-autonomy/schemas/scenario.schema.json",
  "title": "Falcon scenario (falcon.scenario/1)",
  "description": "One scenario as core/scenarios.py documents it: actors placed around the ego by lane and distance, a timeline of triggers and actions, parameters as distributions. An expression is a number or a string of parameters ('$name'), numbers and + - * / ('$speed + $faster'). A scenario written from a description (core/scenario_text.py) is validated against this schema, then by core.scenarios.validate.",
  "type": "object",
  "required": ["name", "duration_s", "ego", "actors", "timeline"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "falcon.scenario/1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "about": {"type": "string", "maxLength": 800},
    "duration_s": {"anyOf": [{"type": "number", "minimum": 4, "maximum": 60}, {"$ref": "#/$defs/param_expr"}]},
    "needs": {"type": "array", "uniqueItems": true,
              "items": {"enum": ["adjacent_same", "opposite", "junction_turn", "speed_breaker"]},
              "description": "road features the start must have: a same-direction lane on the overtaking side, an oncoming lane, a junction turn across traffic within 60 m, a speed breaker 10-60 m ahead (an imported world with road features only)"},
    "params": {"type": "object", "maxProperties": 16,
               "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"},
               "additionalProperties": {"$ref": "#/$defs/param"}},
    "ego": {"type": "object", "required": ["speed_kmh"], "additionalProperties": false,
            "properties": {"speed_kmh": {"$ref": "#/$defs/expr"},
                           "driver": {"enum": ["follower", "none", "autopilot"]},
                           "route": {"enum": ["straight", "turn_across"]}}},
    "weather": {"$ref": "#/$defs/weather"},
    "actors": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/actor"}},
    "timeline": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/event"}},
    "pass": {"type": "object", "additionalProperties": false,
             "properties": {"no_collision": {"type": "boolean"}, "min_ttc_s": {"$ref": "#/$defs/expr"}}},
    "builtin": {"type": "boolean"},
    "source": {"type": "object", "description": "where the scenario came from (Falcon writes it)"}
  },
  "$defs": {
    "param_expr": {"type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[-+*/(). 0-9A-Za-z_$]*\\$[A-Za-z_][-+*/(). 0-9A-Za-z_$]*$"},
    "expr": {"anyOf": [{"type": "number"}, {"$ref": "#/$defs/param_expr"}]},
    "param": {
      "type": "object", "required": ["dist"],
      "properties": {
        "dist": {"enum": ["fixed", "uniform", "normal", "choice"]},
        "value": {}, "lo": {"type": "number"}, "hi": {"type": "number"},
        "mean": {"type": "number"}, "sd": {"type": "number", "exclusiveMinimum": 0},
        "choices": {"type": "array", "minItems": 1, "maxItems": 16},
        "unit": {"type": "string", "maxLength": 16}, "about": {"type": "string", "maxLength": 200}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"dist": {"const": "fixed"}}}, "then": {"required": ["value"]}},
        {"if": {"properties": {"dist": {"const": "uniform"}}}, "then": {"required": ["lo", "hi"]}},
        {"if": {"properties": {"dist": {"const": "normal"}}}, "then": {"required": ["mean", "sd"]}},
        {"if": {"properties": {"dist": {"const": "choice"}}}, "then": {"required": ["choices"]}}]},
    "kind": {"anyOf": [
      {"enum": ["car", "truck", "bus", "van", "motorcycle", "bicycle", "pedestrian", "child", "autorickshaw",
                "cycle_rickshaw", "cattle", "handcart", "vendor"]},
      {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"}]},
    "actor": {
      "type": "object", "required": ["id", "kind", "place"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"},
        "kind": {"$ref": "#/$defs/kind"},
        "place": {"type": "object", "required": ["lane", "ahead_m"], "additionalProperties": false,
                  "properties": {"lane": {"enum": ["ego", "adjacent", "line", "opposite", "kerb", "sidewalk",
                                                   "far_sidewalk"]},
                                 "ahead_m": {"$ref": "#/$defs/expr"}, "lateral_m": {"$ref": "#/$defs/expr"}}},
        "heading": {"enum": ["lane", "against", "across"]},
        "speed_kmh": {"$ref": "#/$defs/expr"},
        "start": {"enum": ["moving", "stopped"]}}},
    "trigger": {
      "type": "object", "required": ["type"],
      "oneOf": [
        {"properties": {"type": {"const": "time"}, "t_s": {"$ref": "#/$defs/expr"}}, "required": ["type", "t_s"],
         "additionalProperties": false},
        {"properties": {"type": {"const": "distance"}, "actor": {"type": "string"}, "lt_m": {"$ref": "#/$defs/expr"}},
         "required": ["type", "actor", "lt_m"], "additionalProperties": false},
        {"properties": {"type": {"const": "ahead"}, "actor": {"type": "string"}, "gt_m": {"$ref": "#/$defs/expr"}},
         "required": ["type", "actor", "gt_m"], "additionalProperties": false}]},
    "action": {
      "type": "object", "required": ["actor", "do"], "additionalProperties": false,
      "properties": {
        "actor": {"type": "string"},
        "do": {"enum": ["speed", "brake", "lane_change", "walk", "open_door", "go", "stop"]},
        "kmh": {"$ref": "#/$defs/expr"}, "accel": {"$ref": "#/$defs/expr"}, "decel": {"$ref": "#/$defs/expr"},
        "to": {"enum": ["ego", "adjacent", "kerb"]}, "duration_s": {"$ref": "#/$defs/expr"},
        "speed_mps": {"$ref": "#/$defs/expr"}, "door": {"enum": ["offside", "FL", "FR", "RL", "RR"]}}},
    "event": {"type": "object", "required": ["trigger", "actions"], "additionalProperties": false,
              "properties": {"trigger": {"$ref": "#/$defs/trigger"},
                             "actions": {"type": "array", "minItems": 1, "maxItems": 6,
                                         "items": {"$ref": "#/$defs/action"}}}},
    "weather": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preset": {"enum": ["ClearNoon", "CloudyNoon", "WetNoon", "WetCloudyNoon", "SoftRainNoon", "MidRainyNoon",
                            "HardRainNoon", "ClearSunset", "CloudySunset", "WetSunset", "WetCloudySunset",
                            "SoftRainSunset", "MidRainSunset", "HardRainSunset", "ClearNight", "CloudyNight",
                            "WetNight", "WetCloudyNight", "SoftRainNight", "MidRainyNight", "HardRainNight",
                            "DustStorm"]},
        "sun_altitude_angle": {"type": "number", "minimum": -90, "maximum": 90},
        "sun_azimuth_angle": {"type": "number", "minimum": -1, "maximum": 360},
        "cloudiness": {"type": "number", "minimum": 0, "maximum": 100},
        "precipitation": {"type": "number", "minimum": 0, "maximum": 100},
        "precipitation_deposits": {"type": "number", "minimum": 0, "maximum": 100},
        "wetness": {"type": "number", "minimum": 0, "maximum": 100},
        "wind_intensity": {"type": "number", "minimum": 0, "maximum": 100},
        "fog_density": {"type": "number", "minimum": 0, "maximum": 100},
        "fog_distance": {"type": "number", "minimum": 0},
        "fog_falloff": {"type": "number", "minimum": 0},
        "scattering_intensity": {"type": "number", "minimum": 0},
        "mie_scattering_scale": {"type": "number", "minimum": 0},
        "rayleigh_scattering_scale": {"type": "number", "minimum": 0},
        "dust_storm": {"type": "number", "minimum": 0, "maximum": 100}}}
  }
}
