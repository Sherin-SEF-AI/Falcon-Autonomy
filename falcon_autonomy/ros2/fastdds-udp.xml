<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS over UDP only (no shared-memory transport): what CARLA 0.9.16's ROS 2 example uses
     (PythonAPI/examples/ros2/config/fastrtps-profile.xml). Shared memory between a container and the host, or between
     CARLA's embedded Fast DDS and ROS's, is not reliable; UDP on the loopback is. Use it with
     FASTRTPS_DEFAULT_PROFILES_FILE=<this file>. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>FalconUdp</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="falcon_udp_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>FalconUdp</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
